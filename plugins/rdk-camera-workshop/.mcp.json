{
  "mcpServers": {
    "rdk-camera-workshop": {
      "transport": "stdio",
      "command": "node",
      "args": ["mcp/bridge.mjs"]
    },
    "rdk-vision-workshop": {
      "transport": "stdio",
      "command": "node",
      "args": ["mcp/course-server.mjs"],
      "requestTimeoutMs": 30000,
      "permissions": {
        "default": "deny",
        "tools": {
          "vision_course_plan": "readonly",
          "vision_course_stage": "readonly"
        }
      }
    }
  }
}
